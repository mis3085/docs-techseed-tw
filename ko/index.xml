        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100 select-none&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%ec%a7%80%ec%86%8d-%ea%b0%80%eb%8a%a5%ed%95%9c-%ec%82%b0%ec%97%85-%eb%b0%9c%ec%a0%84%ec%9d%84-%ec%9c%84%ed%95%9c-esg-%ec%9b%90%ec%b9%99-%ed%86%b5%ed%95%a9&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
